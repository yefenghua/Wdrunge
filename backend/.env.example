DASHSCOPE_API_KEY=your-dashscope-api-key
QWEN_MODEL=qwen3.7-max
QWEN_CONTEXT_WINDOW=131072
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Context compression ratios are measured after reserving output tokens.
CONTEXT_COMPRESSION_SOFT_RATIO=0.45
CONTEXT_COMPRESSION_MEDIUM_RATIO=0.62
CONTEXT_COMPRESSION_HARD_RATIO=0.80
CONTEXT_COMPRESSION_TARGET_RATIO=0.38
CONTEXT_RESERVED_OUTPUT_TOKENS=8192
CONTEXT_COMPRESSION_CHUNK_TOKENS=12000
CONTEXT_COMPRESSION_SUMMARY_TOKENS=2400
CONTEXT_COMPRESSION_L1_RECENT=10
CONTEXT_COMPRESSION_L2_RECENT=6
CONTEXT_COMPRESSION_L3_RECENT=1
